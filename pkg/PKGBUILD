pkgname=gitfusion
pkgver=0.2.0
pkgrel=1
pkgdesc="Cliente Git desktop (Tauri + React)"
arch=('x86_64')
license=('custom')
depends=('webkit2gtk-4.1' 'gtk3' 'git' 'dbus')
options=('!strip')
source=('gitfusion' 'gitfusion.desktop' 'gitfusion.png' 'gitfusion-512.png')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  install -Dm755 gitfusion "$pkgdir/usr/bin/gitfusion"
  install -Dm644 gitfusion.desktop "$pkgdir/usr/share/applications/gitfusion.desktop"
  install -Dm644 gitfusion.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/gitfusion.png"
  install -Dm644 gitfusion-512.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/gitfusion.png"
}
